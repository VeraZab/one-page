#!/usr/bin/env bash
# Pre-commit automation for this repo. Both steps fail open — they never block a
# commit. Git is told to use this folder via `core.hooksPath` (see package.json
# "prepare"), so everything lives under .claude/ and is committed with the repo.
set -uo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

# 1. Blog posts — rewrite + correct the SEO (meta description + keywords) for
#    search engines and AI agents, with an LLM, then re-stage.
posts=$(staged | grep -E '^content/posts/.*\.mdx$' || true)
if [ -n "$posts" ]; then
  # shellcheck disable=SC2086
  node .claude/hooks/optimize-post-seo.mjs $posts || true
fi

# 2. CV source changed — regenerate the PDF and stage it.
if staged | grep -qE '^cv/content\.json$'; then
  echo "Regenerating CV…"
  node .claude/hooks/build-cv.mjs || true
  git add public/VERA_ZABEIDA_Senior_Full_Stack_Engineer.pdf cv/cv.html 2>/dev/null || true
fi
